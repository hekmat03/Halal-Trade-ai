# =============================================================================
# HalalTrade AI — environment variable template
#
# Copy to `.env` (or export in your shell) and fill with REAL values at runtime.
# Secrets/API keys MUST come from the environment only — never hardcoded in code.
# All variables use the HALAL_ prefix.
# =============================================================================

# --- Runtime mode -----------------------------------------------------------
# backtest | paper | live        (live trades are DISABLED by default)
HALAL_TRADING_MODE=paper
HALAL_LIVE_ENABLED=false

# --- Secrets (environment only; never commit real values) -------------------
HALAL_BINANCE_API_KEY=
HALAL_BINANCE_API_SECRET=

# --- Security posture -------------------------------------------------------
HALAL_API_KEY_RESTRICTED=true        # false => Security gate rejects and STOPS
HALAL_SYSTEM_HEALTHY=true            # false => Security gate rejects and STOPS

# --- Risk Policy (hard user-configurable caps, USDT unless noted) -----------
HALAL_MAX_POSITION_SIZE=500
HALAL_MAX_EXPOSURE=2000
HALAL_MAX_LOSS_PER_TRADE=50
HALAL_MAX_DAILY_LOSS=100
HALAL_MAX_DRAWDOWN=0.10
HALAL_MIN_ACCOUNT_BALANCE=100

# --- Execution validation ----------------------------------------------------
HALAL_MIN_NOTIONAL=5                 # BTCUSDT Binance minimum order notional (USDT)
HALAL_MAX_DATA_AGE_SECONDS=5         # reject signals older than this
# --- Market data (Delivery 2) ------------------------------------------------
# Public market data needs NO API key; endpoints are overridable via env.
HALAL_MARKET_DATA_MAX_AGE_SECONDS=5  # refuse market data older than this
HALAL_BINANCE_REST_BASE=https://api.binance.com
HALAL_BINANCE_WS_BASE=wss://stream.binance.com:9443

# --- Persistence -------------------------------------------------------------
HALAL_DATABASE_URL=sqlite:///halaltrade.db
# --- Paper run (Delivery 8) — simulated money, live stays OFF -----------------
HALAL_TRADING_MODE=paper             # paper mode only; live is disabled
HALAL_LIVE_ENABLED=false             # master live switch — keep false
HALAL_PAPER_SYMBOL=BTCUSDT
HALAL_PAPER_STARTING_USDT=1000       # simulated starting balance (USDT)
HALAL_PAPER_STRATEGY=donchian_1d     # strategies.get_strategy() registry name
HALAL_PAPER_TIMEFRAME=1d             # candle timeframe for the paper clock
HALAL_PAPER_TRADE_AMOUNT_USDT=100    # the owner's explicit size per entry (USDT)
HALAL_PAPER_STOP_LOSS_PCT=0.02       # mandatory stop if a signal carries none
HALAL_PAPER_POLL_SECONDS=3600        # how often the run re-reads the market
HALAL_PAPER_CANDLE_MAX_AGE_BARS=2.0  # refuse bars older than this many bar-durations
HALAL_PAPER_DAILY_REPORT_UTC=18:00   # daily Telegram report time (UTC)
HALAL_PAPER_WEEKLY_REPORT_UTC=12:00  # weekly Telegram report time (UTC)
HALAL_PAPER_WEEKLY_REPORT_DAY=SUN    # weekly Telegram report weekday (UTC)
# --- Telegram reports (Delivery 8) — all OFF by default ----------------------
# A report is only delivered when ENABLED=true AND a token AND a chat_id are set
# AND the alert toggle below is true; otherwise it is built + logged (delivered:false).
HALAL_TELEGRAM_ENABLED=false
HALAL_TELEGRAM_BOT_TOKEN=            # e.g. 123456789:AAH...your-bot-token (env only, never commit)
HALAL_TELEGRAM_CHAT_ID=              # e.g. -1001234567890 or 123456789
HALAL_TELEGRAM_ALERT_DAILY_PNL=false # gate for the daily/weekly paper reports
HALAL_TELEGRAM_ALERT_STRATEGY_CHANGE=false
HALAL_TELEGRAM_ALERT_EMERGENCY_STOP=false
HALAL_TELEGRAM_ALERT_RISK_REJECTION=false
HALAL_TELEGRAM_ALERT_SYSTEM_ERROR=false
